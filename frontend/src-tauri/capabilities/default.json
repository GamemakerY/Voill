{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "user-input:default",
    "audio-recorder:default",
    "fs:allow-temp-read", 
    "core:window:allow-close",
    {
      "identifier": "fs:allow-temp-read",
      "allow": [{ "path": "$TEMP/*" }]
    }
  ]
}
