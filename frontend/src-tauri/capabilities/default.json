{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "user-input:default",
    "audio-recorder:default",
    "fs:allow-temp-read", 
    "core:window:allow-close",
    "store:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "stronghold:default",
    {
      "identifier": "fs:allow-temp-read",
      "allow": [{ "path": "$TEMP/*" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/api",
          "sidecar": true
        }
      ]
    }
  ]
}
